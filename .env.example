# Web
NEXT_PUBLIC_API_URL=http://localhost:8080

# Core API
AiService__BaseUrl=http://localhost:8000

# Future production persistence
POSTGRES_CONNECTION_STRING=postgresql://postgres:postgres@localhost:5432/sdlc_ai

# Future model adapters - never commit real secrets
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# AI provider (deterministic requires no credentials)
AI_PROVIDER=deterministic
AI_MODEL=gpt-5-mini
AI_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=2
